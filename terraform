# 


terraform {
  required_version = ">= 1.0.0"
}

variable "project_name" {
  description = "Name of my DevSecOps project"
  type        = string
  default     = "my-devsecops"
}

output "project_message" {
  description = "Display the project name"
  value       = "Welcome to ${var.project_name}!"
}
